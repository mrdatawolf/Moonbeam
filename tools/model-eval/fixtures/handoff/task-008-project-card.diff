diff --git a/ui/src/components/ProjectCard.tsx b/ui/src/components/ProjectCard.tsx
new file mode 100644
index 0000000..a41b9e2
--- /dev/null
+++ b/ui/src/components/ProjectCard.tsx
@@ -0,0 +1,34 @@
+import type { ProjectSummary } from '@moonbeam/shared';
+import { StatusDot } from './StatusDot';
+
+export function ProjectCard({ project }: { project: ProjectSummary }) {
+  const needsHuman = project.openPauseCount + project.inReviewCount;
+  return (
+    <article className="project-card" aria-labelledby={`p-${project.id}`}>
+      <header>
+        <h2 id={`p-${project.id}`}>{project.name}</h2>
+        <StatusDot state={project.activeRuns > 0 ? 'running' : 'idle'} />
+      </header>
+      <dl>
+        <dt>Active runs</dt>
+        <dd>{project.activeRuns}</dd>
+        <dt>Waiting on the board</dt>
+        <dd>{needsHuman}</dd>
+      </dl>
+    </article>
+  );
+}
